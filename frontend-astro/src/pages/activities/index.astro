---
import Layout from '../../layouts/Layout.astro';
import { getActivities } from '../../lib/api';

// Esto corre en build time: el fetch queda "congelado" en el HTML generado.
const activities = await getActivities();
---
<Layout title="Actividades">
  <h1>Actividades</h1>
  <ul>
    {activities.map((activity) => (
      <li>
        <a href={`/activities/${activity.id}/`}>
          <strong>{activity.title}</strong>
        </a>
        <p>{new Date(activity.starts_at).toLocaleString('es-AR')}</p>
        <p>{activity.available_slots} / {activity.capacity} cupos disponibles</p>
      </li>
    ))}
  </ul>
</Layout>