---
import Layout from '../../layouts/Layout.astro';
import { getActivities, getActivity } from '../../lib/api';
import EnrollmentStatus from '../../components/EnrollmentStatus.tsx';

export async function getStaticPaths() {
  const activities = await getActivities();
  return activities.map((activity) => ({ params: { id: activity.id } }));
}

const { id } = Astro.params;
const activity = await getActivity(id as string);

const apiBase = import.meta.env.PUBLIC_API_BASE;
const participantId = import.meta.env.PUBLIC_DEMO_PARTICIPANT_ID;

// Se genera UNA sola vez, en build time. Queda fijo en el HTML resultante
// hasta el próximo `pnpm build` — sirve para demostrar qué quedó "congelado".
const buildColor = `hsl(${Math.floor(Math.random() * 360)}, 70%, 60%)`;
---
<Layout title={activity.title}>
  <div style={`padding: 0.5rem 1rem; background:${buildColor}; border-radius:6px; margin-bottom:1rem;`}>
    <strong>Color de build:</strong> {buildColor}
    <br />
    <small>Generado en build time — no cambia al recargar, solo con un nuevo `pnpm build`.</small>
  </div>

  <h1>{activity.title}</h1>
  <p>{new Date(activity.starts_at).toLocaleString('es-AR')}</p>
  <p>Capacidad: {activity.capacity}</p>

  <EnrollmentStatus
    client:load
    activityId={activity.id}
    apiBase={apiBase}
    participantId={participantId}
  />
</Layout>